---
import CardProyect from "./CardProyect.astro"
import CardProyectVideo from "./CardProyectVideo.astro"
---

<section
	class="animation flex flex-col items-center justify-center overflow-visible px-6"
>
	<h2 class="my-20 mt-20 text-center text-5xl sm:my-28">Proyectos</h2>
	<div
		class="grid max-w-[60rem] grid-cols-1 items-center justify-center gap-10 md:grid-cols-2"
	>
		<CardProyectVideo
			site="https://linktr.ee/acuanet"
			video="/aquanetReel.mp4"
			title="AquaNet"
			parf="App móvil dedicada para pescadores españoles con más de 1.000 usuarios activos. La app permite a los usuarios registrar sus capturas y acceder rápidamente a información hidrológica y meteorológica de sus embalses favoritos."
			stack1="React Native"
			stack2="Expo"
			stack3="Supabase"
			stack4="RevenueCat"
			stack1c="bg-cyan-500/60"
			stack2c="bg-black/60"
			stack3c="bg-emerald-500/60"
			stack4c="bg-rose-400/60"
		/>
		<CardProyect
			site="https://agrbaits.com"
			img1="1.webp"
			img2="2.webp"
			img3="3.webp"
			img4="4.webp"
			img5="5.webp"
			title="AGR Baits"
			parf="Página web completa con todos los productos de una de las principales marcas de pesca en España AGR Baits. Se ha diseñado toda la arquitectura digital de la empresa, desde una app para las personas patrocinadas hasta organización de torneos."
			stack1="Astro"
			stack2="React"
			stack3="Typescript"
			stack4="Supabase"
			stack5="Vercel"
			stack1c="bg-teal-500/60"
			stack2c="bg-orange-400/60"
			stack3c="bg-blue-400/60"
			stack4c="bg-green-400/60"
			stack5c="bg-blue-300/60"
			stack6c="bg-black"
			speed="500"
		/>
	</div>
</section>
<style>
	.animation {
		opacity: 0;
		transition: opacity 2s;
	}

	.scroll-animation {
		opacity: 1;
	}
</style>

<script>
	function setupAnimations() {
		const elementsToAnimate = document.querySelectorAll(".animation")

		const observer = new IntersectionObserver(
			(entries, observer) => {
				entries.forEach((entry) => {
					if (entry.isIntersecting) {
						// Agrega la animación cuando el elemento es visible en el viewport
						entry.target.classList.add("scroll-animation")

						// Deja de observar el elemento si ya se ha animado
						observer.unobserve(entry.target)
					}
				})
			},
			{ threshold: 0.3 } // El umbral puede ser ajustado según tu necesidad
		)

		elementsToAnimate.forEach((element) => {
			observer.observe(element)
		})
	}

	document.addEventListener("DOMContentLoaded", setupAnimations)
</script>
