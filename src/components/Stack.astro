---
import { techStack } from "@/data/tech"
---

<section
	class="mb-24 flex flex-col items-center justify-center px-6 sm:mb-32"
	aria-labelledby="tecnologias"
>
	<h2 id="tecnologias" class="mt-20 text-center text-5xl sm:mt-28">Tecnologías</h2>
	<p class="mt-6 max-w-md text-center text-sm leading-relaxed text-gray-400">
		El stack con el que construyo AquaNet, FishEye y AGR Baits.
	</p>
	<ul
		class="mt-12 grid w-full max-w-5xl grid-cols-2 gap-px overflow-hidden rounded-lg border border-white/10 bg-white/10 sm:grid-cols-4"
	>
		{
			techStack.map((tech, i) => (
				<li class="tech flex items-center gap-3 bg-[#03071b] px-4 py-5 sm:px-5" style={`--i: ${i}`}>
					<span
						class="flex size-8 shrink-0 items-center justify-center [&>svg]:h-7 [&>svg]:w-7"
						aria-hidden="true"
						set:html={tech.svg}
					/>
					<span class="tech-name text-[0.8rem] leading-tight text-gray-400 sm:text-sm">{tech.name}</span>
				</li>
			))
		}
	</ul>
</section>

<style>
	.tech {
		opacity: 0;
		transform: translateY(12px);
		transition:
			opacity 300ms cubic-bezier(0.23, 1, 0.32, 1) calc(var(--i) * 25ms),
			transform 300ms cubic-bezier(0.23, 1, 0.32, 1) calc(var(--i) * 25ms),
			background-color 180ms ease;
	}

	.tech.is-in {
		opacity: 1;
		transform: none;
	}

	.tech-name {
		transition: color 180ms ease;
	}

	@media (hover: hover) and (pointer: fine) {
		.tech:hover {
			background-color: #0a1228;
		}

		.tech:hover .tech-name {
			color: #fff;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.tech {
			transform: none;
			transition: opacity 200ms ease;
		}
	}
</style>

<script>
	const items = document.querySelectorAll(".tech")
	const observer = new IntersectionObserver(
		(entries) => {
			entries.forEach((entry) => {
				if (!entry.isIntersecting) return
				entry.target.classList.add("is-in")
				observer.unobserve(entry.target)
			})
		},
		{ threshold: 0.15 }
	)

	items.forEach((item) => observer.observe(item))
</script>
